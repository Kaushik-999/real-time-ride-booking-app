{
  "name": "uber-clone-server",
  "version": "1.0.0",
  "description": "Ride-booking API, matching engine and recovery worker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/index.js",
    "worker:dev": "node --watch src/workers/index.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "simulate:drivers": "node scripts/simulateDrivers.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:ci": "jest --ci --runInBand",
    "dev:outbox": "node scripts/devOutbox.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@socket.io/mongo-adapter": "^0.4.0",
    "@socket.io/mongo-emitter": "^0.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "pino": "^9.14.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/env.js"
    ],
    "testTimeout": 30000,
    "maxWorkers": "50%",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
