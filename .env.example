# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Values left empty fall back to development-only defaults; production
# (NODE_ENV=production) refuses to start without JWT_SECRET and
# PAYMENT_WEBHOOK_SECRET.

# --- Secrets -----------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PAYMENT_WEBHOOK_SECRET=change-me
JWT_EXPIRES_IN=1h

# Bootstrap admin, created by: docker compose exec backend npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Server ------------------------------------------------------------
# MONGO_URI is set by docker-compose.yml for containers. Only set it here
# when running the backend directly on your machine (outside Docker):
# MONGO_URI=mongodb://localhost:27017/uber?directConnection=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Matching ----------------------------------------------------------
MATCH_INITIAL_RADIUS_KM=3
MATCH_RADIUS_STEP_KM=3
MATCH_MAX_RADIUS_KM=12
OFFER_TIMEOUT_MS=15000
MATCH_CANDIDATE_PAGE_SIZE=10
LOCATION_FRESHNESS_MS=30000

# --- Fare (paise; 100 paise = 1 INR) -----------------------------------
FARE_BASE_PAISE=5000
FARE_PER_KM_PAISE=1200
FARE_PER_MIN_PAISE=150
FARE_MINIMUM_PAISE=8000
FARE_AVG_SPEED_KMH=25
ROUTING_PROVIDER=straight_line
# OSRM_URL=https://router.project-osrm.org

# --- Recovery worker ---------------------------------------------------
WORKER_INTERVAL_MS=5000

# --- One-time codes (login + trip verification) --------------------------
# OTP_SECRET keys the HMAC used to store codes as hashes.
# TRIP_OTP_ENCRYPTION_KEY: 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=change-me
TRIP_OTP_ENCRYPTION_KEY=change-me
TRIP_OTP_TTL_MS=3600000
TRIP_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_TTL_MS=300000
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_MS=60000
LOGIN_OTP_MAX_PER_HOUR=5

# --- SMS delivery ----------------------------------------------------------
# dev_outbox (development only: nothing is sent; read codes with
#   docker compose exec backend npm run dev:outbox), twilio, or disabled.
# Production refuses dev_outbox.
SMS_PROVIDER=dev_outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google sign-in (OpenID Connect) ---------------------------------------
# OAuth 2.0 Web client id from Google Cloud Console. Empty = Google sign-in off.
GOOGLE_CLIENT_ID=

# --- Driver documents ------------------------------------------------------
# 64 hex chars (32 bytes). Files are encrypted at rest with this key.
DOCUMENT_ENCRYPTION_KEY=change-me
DOCUMENT_MAX_BYTES=5242880
DRIVER_REQUIRED_DOCUMENTS=PHOTO,DRIVING_LICENSE,VEHICLE_RC,AADHAAR
DOCUMENT_RETENTION_DAYS=30
# DOCUMENT_STORAGE_DIR is set by docker-compose.yml (/app/private-uploads volume).

# --- Vehicles (optional override of the built-in catalog) ------------------
# VEHICLE_CATALOG_JSON={"BIKE":{"label":"Bike","category":"BIKE","defaultCapacity":1,"maxCapacity":1,"fare":{"basePaise":2500,"perKmPaise":600,"perMinPaise":100,"minimumPaise":3000}}}

# --- Reviews and chat -------------------------------------------------------
REVIEW_WINDOW_DAYS=14
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT_COUNT=10
CHAT_RATE_LIMIT_WINDOW_MS=10000
CHAT_READ_AFTER_RIDE_MS=86400000
CHAT_RETENTION_DAYS=30

# --- Safety / emergency integration ----------------------------------------
# none = no external emergency service (the app says so honestly).
# webhook = POST signed alerts to an AUTHORISED emergency-response service.
EMERGENCY_PROVIDER=none
EMERGENCY_WEBHOOK_URL=
EMERGENCY_WEBHOOK_SECRET=change-me
EMERGENCY_MAX_ATTEMPTS=5
EMERGENCY_PHONE_NUMBER=112

# --- Women-driver preference -----------------------------------------------
FEMALE_DRIVER_PREFERENCE_ENABLED=true
